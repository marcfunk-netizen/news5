<script>
const CATS = [
  {id:"african-cdc",   label:"Africa CDC",                  icon:"🌍", desc:"Publications et communiqués"},
  {id:"ama",           label:"Agence Médicament Afrique",    icon:"💊", desc:"Actualités AMA réglementaires"},
  {id:"manufacture",   label:"Manufacture Vaccins Afrique",  icon:"🏭", desc:"Production vaccins biologiques"},
  {id:"unicef-gavi",   label:"UNICEF & GAVI",                icon:"💉", desc:"Campagnes immunisation"},
  {id:"sante-maroc",   label:"Santé Maroc",                  icon:"🇲🇦", desc:"Système de soins marocain"},
  {id:"vaccins-monde", label:"Vaccins dans le Monde",        icon:"🌐", desc:"Actualités mondiales"},
];
let active = "african-cdc";
let allData = {};
function srcColor(url) {
  try {
    const h = new URL(url).hostname;
    if (h.includes("africacdc") || h.includes("au.int")) return "#1B8C3A";
    if (h.includes("who.int"))   return "#0093D5";
    if (h.includes("unicef"))    return "#00AEEF";
    if (h.includes("gavi"))      return "#E8702A";
    if (h.includes(".ma") || h.includes("maroc")) return "#C1272D";
    if (h.includes("nature.com")) return "#B5232D";
  } catch(e) {}
  return "#0069B4";
}
function domain(url) {
  try { return new URL(url).hostname.replace("www.", ""); } catch(e) { return "source"; }
}
function fmtDate(d) {
  if (!d) return "";
  try {
    const dt = new Date(d);
    if (isNaN(dt)) return d;
    return dt.toLocaleDateString("fr-FR", {day:"numeric", month:"short", year:"numeric"});
  } catch(e) { return d; }
}
function setStatus(msg, state) {
  document.getElementById("status-text").textContent = msg;
  const dot = document.getElementById("dot");
  dot.className = "dot" + (state === "loading" ? " loading" : state === "error" ? " error" : "");
}
function renderCats() {
  document.getElementById("cats").innerHTML = CATS.map(c =>
    `<button class="cat${active === c.id ? " active" : ""}" data-id="${c.id}">
      <div class="cat-icon">${c.icon}</div>
      <div class="cat-label">${c.label}</div>
      <div class="cat-desc">${c.desc}</div>
    </button>`
  ).join("");
  document.querySelectorAll(".cat").forEach(b =>
    b.addEventListener("click", () => { active = b.dataset.id; renderCats(); renderArticles(); })
  );
}
function renderArticles() {
  const el = document.getElementById("articles");
  const articles = allData[active] || [];
  if (!articles.length) {
    el.innerHTML = '<div class="empty">Aucun article disponible.</div>';
    return;
  }
  el.innerHTML = articles.map((a, i) => {
    const color = srcColor(a.url || "");
    return `<div class="card" style="animation-delay:${i * 0.05}s">
      <div class="card-inner">
        <div class="bar" style="background:${color}"></div>
        <div class="card-body">
          <a href="${a.url || '#'}" target="_blank" rel="noopener" class="card-title">${a.title || "Sans titre"}</a>
          <div class="card-content" id="cc-${i}">${a.content || ""}</div>
          <div class="card-meta">
            <span class="src" style="background:${color}18;color:${color}">${domain(a.url || "")}</span>
            ${a.date ? `<span class="date">${fmtDate(a.date)}</span>` : ""}
            <button class="more-btn" data-i="${i}">Lire plus</button>
          </div>
        </div>
      </div>
    </div>`;
  }).join("");
  document.querySelectorAll(".more-btn").forEach(b =>
    b.addEventListener("click", () => {
      const cc = document.getElementById("cc-" + b.dataset.i);
      b.textContent = cc.classList.toggle("expanded") ? "Réduire" : "Lire plus";
    })
  );
}
async function loadAll() {
  setStatus("Chargement des actualités...", "loading");
  try {
    const resp = await fetch("/api/refresh");
    if (!resp.ok) throw new Error(`Erreur ${resp.status}`);
    allData = await resp.json();
    renderArticles();
    const now = new Date().toLocaleTimeString("fr-FR", {hour:"2-digit", minute:"2-digit"});
    setStatus(`Actualisé à ${now}`, "ok");
  } catch(e) {
    setStatus("Erreur de chargement — " + e.message, "error");
    document.getElementById("articles").innerHTML =
      '<div class="empty">Impossible de charger les actualités.<br>Vérifiez votre connexion ou revenez plus tard.</div>';
  }
}
renderCats();
loadAll();
</script>
